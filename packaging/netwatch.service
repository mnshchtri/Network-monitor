[Unit]
Description=netwatch defensive network monitor
After=network.target

[Service]
ExecStart=/usr/local/bin/netwatch watch --log /var/log/netwatch/alerts.jsonl
Restart=on-failure
LogsDirectory=netwatch
# Needs root to map sockets to processes; otherwise read-only and locked down.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/log/netwatch
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
